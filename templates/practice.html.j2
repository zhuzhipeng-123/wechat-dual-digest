{% extends "base.html.j2" %}
{% block title %}练习日报 · {{ report.target_date }}{% endblock %}
{% block heading %}练习日报{% endblock %}
{% block content %}
  {% if report.articles %}
    {% for article in report.articles %}<article>
      <h2>{{ article.title }}</h2><p>{{ article.account }} · {{ article.publish_time }}</p>
      <div>{{ article.sanitized_html|safe }}</div>
      {% for image in article.images|default([]) %}{% if image.status == "ok" %}<img src="{{ image.relative_path }}" alt="{{ article.title }}配图">{% endif %}{% endfor %}
      <p><a href="{{ article.url }}" rel="noopener noreferrer">打开唯一原文入口</a></p>
    </article>{% endfor %}
  {% elif report.source_status.value == "empty" %}<p class="notice">本次搜索成功，但未发现命中标题规则的练习文章。</p>
  {% else %}<p class="notice">本次无法确认是否有练习文章，请查看数据源状态和错误。</p>{% endif %}
  {% for article in report.pending %}<article><h2>{{ article.title }}</h2><p>时间或正文待核实，不计入正式窗口。</p><a href="{{ article.url }}" rel="noopener noreferrer">打开唯一原文入口</a></article>{% endfor %}
{% endblock %}
