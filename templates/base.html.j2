<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="data:,">
  <title>{% block title %}双日报{% endblock %}</title>
  <style>
    :root { --ink:#15222e; --paper:#f5f7f4; --muted:#65717b; --line:#ccd6d0; --accent:#0b6e69; --warn:#a4492c; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--paper); font:16px/1.65 "Microsoft YaHei UI", "Noto Sans SC", sans-serif; }
    header,main { width:min(1040px, calc(100% - 32px)); margin:auto; }
    header { padding:48px 0 24px; border-bottom:2px solid var(--ink); }
    h1 { margin:0; font:700 clamp(36px,8vw,78px)/.95 Georgia,"Songti SC",serif; letter-spacing:-.05em; }
    .meta { display:flex; flex-wrap:wrap; gap:8px 24px; margin-top:24px; color:var(--muted); font-size:14px; }
    main { padding:28px 0 64px; }
    .status { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line); }
    .status div { background:white; padding:14px 16px; }
    .status strong { display:block; font-size:13px; color:var(--muted); font-weight:500; }
    .notice { margin:24px 0; padding:16px 18px; border-left:5px solid var(--warn); background:#fff5ef; }
    article { margin:28px 0; padding:24px; background:white; border:1px solid var(--line); }
    article h2 { margin:0 0 8px; font:700 25px/1.3 Georgia,"Songti SC",serif; }
    a { color:var(--accent); text-underline-offset:3px; }
    .tag { display:inline-block; margin:0 6px 6px 0; padding:2px 8px; border:1px solid currentColor; font-size:12px; }
    .error { color:var(--warn); }
    .missing-image { display:block; margin:12px 0; padding:12px; color:var(--warn); background:#fff5ef; border:1px dashed currentColor; }
    .article-body { overflow-wrap:anywhere; }
    table { display:block; max-width:100%; overflow-x:auto; border-collapse:collapse; }
    th,td { padding:6px 8px; border:1px solid var(--line); }
    img { max-width:100%; height:auto; }
    :focus-visible { outline:3px solid #e6a23c; outline-offset:3px; }
    @media (max-width:600px) { header { padding-top:28px; } article { padding:18px; } .status { grid-template-columns:repeat(2,1fr); } }
  </style>
</head>
<body>
<header>
  <h1>{% block heading %}双日报{% endblock %}</h1>
  <div class="meta">
    <span>窗口 {{ report.window.start.isoformat() }} → {{ report.window.end.isoformat() }}</span>
    <span>{{ report.window.timezone }}</span><span>run {{ report.run_id }}</span>
  </div>
</header>
<main>
  <section class="status" aria-label="运行状态">
    <div><strong>数据源</strong>{{ report.source_status.value }}</div>
    <div><strong>正文与图片</strong>{{ report.fetch_status.value }}</div>
    <div><strong>分析</strong>{{ report.analysis_status.value }}</div>
    <div><strong>覆盖</strong>{{ report.coverage_status.value }}</div>
    <div><strong>发布</strong>{{ report.publication_status.value }}</div>
    <div><strong>发送</strong>{{ report.delivery_status.value }}</div>
    <div><strong>正式入窗</strong>{{ report.articles|length }}</div>
    <div><strong>待核实</strong>{{ report.pending|length }}</div>
  </section>
  {% if report.errors %}<div class="notice"><strong>本次存在 {{ report.errors|length }} 个问题</strong><ul>{% for error in report.errors %}<li>{{ error.stage }} / {{ error.code }}：{{ error.message }}</li>{% endfor %}</ul></div>{% endif %}
  {% block content %}{% endblock %}
</main>
</body>
</html>
